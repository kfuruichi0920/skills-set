        <mxCell id="explanation-0" value="Mode C: PNGを原図として保持。SVGを扱えない環境向けの代替例。拡大時の可読性を確認する。" parent="30" vertex="1" style="whiteSpace=wrap;html=0;fontFamily=sans-serif;fontSize=16;fontColor=#222222;shadow=0;glass=0;gradientColor=none;strokeWidth=1.5;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=8;shape=text;">
          <mxGeometry x="60" y="482.0" width="1150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="explanation-1" value="破線の引出線は注釈との対応。シーケンス図の応答矢印とは区別する。" parent="30" vertex="1" style="whiteSpace=wrap;html=0;fontFamily=sans-serif;fontSize=16;fontColor=#222222;shadow=0;glass=0;gradientColor=none;strokeWidth=1.5;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=8;shape=text;">
