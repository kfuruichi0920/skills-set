        </mxCell>
        <mxCell id="ann-SEQ-01-marker" value="注1" parent="20" vertex="1" style="whiteSpace=wrap;html=0;fontFamily=sans-serif;fontSize=16;fontColor=#161616;shadow=0;glass=0;gradientColor=none;strokeWidth=1.5;fillColor=#EDF5FF;strokeColor=#0F62FE;align=left;verticalAlign=middle;spacingLeft=8;shape=ellipse;align=center;whiteSpace=nowrap;fontSize=12;spacing=0;spacingLeft=0;spacingRight=0;aspect=fixed;strokeColor=#0F62FE;">
          <mxGeometry x="61.0" y="210.1045" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="ann-SEQ-01-explanation" value="注1 申請の受渡し&#10;利用者から受付へ申請を送る。意味は同梱のPlantUMLソースで確認できる。" parent="30" vertex="1" style="whiteSpace=wrap;html=0;fontFamily=sans-serif;fontSize=16;fontColor=#161616;shadow=0;glass=0;gradientColor=none;strokeWidth=1.5;fillColor=#F4F4F4;strokeColor=#8D8D8D;align=left;verticalAlign=middle;spacingLeft=8;shape=note;">
          <mxGeometry x="413.0" y="198.0" width="350" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ann-SEQ-01-leader" value="注釈" parent="20" edge="1" source="ann-SEQ-01-explanation" style="whiteSpace=nowrap;html=0;fontFamily=sans-serif;fontSize=12;fontColor=#161616;shadow=0;glass=0;gradientColor=none;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;curved=0;strokeColor=#8D8D8D;align=center;dashed=1;endArrow=block;strokeColor=#0F62FE;endArrow=none;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="142.5" y="212.1045" as="targetPoint" />
            <Array as="points">
              <mxPoint x="393.0" y="212.1045" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="explanation-0" value="Mode B: SVGを単一の原図として保持。元の.pumlを編集し再レンダリングする。注釈は別レイヤー。" parent="30" vertex="1" style="whiteSpace=wrap;html=0;fontFamily=sans-serif;fontSize=16;fontColor=#161616;shadow=0;glass=0;gradientColor=none;strokeWidth=1.5;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=8;shape=text;">
          <mxGeometry x="60" y="482.0" width="1150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="explanation-1" value="破線の引出線は注釈との対応。シーケンス図の応答矢印とは区別する。" parent="30" vertex="1" style="whiteSpace=wrap;html=0;fontFamily=sans-serif;fontSize=16;fontColor=#161616;shadow=0;glass=0;gradientColor=none;strokeWidth=1.5;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=8;shape=text;">
          <mxGeometry x="60" y="582.0" width="1150" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
