{
  "type": "object",
  "required": [
    "schema_version",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "minItems": 40,
      "items": {
        "type": "object",
        "required": [
          "id",
          "key",
          "title_ja",
          "title_en",
          "purpose",
          "pattern",
          "composition_pattern",
          "artifact",
          "artifact_hash",
          "preview_hash",
          "domain",
          "diagram_type",
          "source_refs",
          "information_structure",
          "visual_pattern",
          "relationships",
          "when_to_use",
          "when_not_to_use",
          "strengths",
          "limitations",
          "tags",
          "core",
          "variant_of",
          "quality",
          "layout",
          "visual",
          "drawio",
          "source_analysis",
          "semantic_shape_requirement",
          "audience"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "title_ja": {
            "type": "string",
            "minLength": 1
          },
          "title_en": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "composition_pattern": {
            "type": "string",
            "minLength": 1
          },
          "artifact": {
            "type": "string",
            "minLength": 1
          },
          "artifact_hash": {
            "type": "string",
            "minLength": 1
          },
          "preview_hash": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "diagram_type": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "information_structure": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "visual_pattern": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "relationships": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          },
          "when_to_use": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "when_not_to_use": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "strengths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "core": {
            "type": "boolean"
          },
          "variant_of": {
            "type": [
              "string",
              "null"
            ]
          },
          "quality": {
            "type": "object",
            "required": [
              "status",
              "findings",
              "reviewed_at"
            ],
            "properties": {
              "status": {
                "const": "accepted"
              },
              "findings": {
                "type": "string",
                "minLength": 10
              }
            }
          },
          "layout": {
            "type": "object",
            "required": [
              "primary_axis",
              "grouping",
              "reading_direction"
            ]
          },
          "visual": {
            "type": "object",
            "required": [
              "theme",
              "density",
              "hierarchy",
              "emphasis"
            ]
          },
          "drawio": {
            "type": "object",
            "required": [
              "libraries",
              "native_features"
            ]
          },
          "source_analysis": {
            "type": "object",
            "required": [
              "observations",
              "adaptation"
            ]
          },
          "semantic_shape_requirement": {
            "type": "array"
          },
          "audience": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
